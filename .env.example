# Handover Ledger Environment Configuration
# Copy this to .env or .env.local

# Session Secret for HMAC Persona Cookie Signing
SESSION_SECRET=handover-ledger-dev-secret-key-32-chars-minimum!!

# Anthropic Claude API Key (optional for pre-seeded demo; needed for live Quick Capture / Extraction)
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Supabase Postgres Configuration (Service Role key stays server-only!)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# LLM Mode: 'live' or 'replay' (offline fallback with recorded responses)
LLM_MODE=live

# Optional App URL for absolute redirects and exports
NEXT_PUBLIC_APP_URL=http://localhost:3000

